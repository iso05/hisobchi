{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListLexaiPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::BUCKET_NOMI",
      "Condition": {"StringLike": {"s3:prefix": ["lexai/*", "lexai"]}}
    },
    {
      "Sid": "ReadLexaiObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::BUCKET_NOMI/lexai/*"
    }
  ]
}
